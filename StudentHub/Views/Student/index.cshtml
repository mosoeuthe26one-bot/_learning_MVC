@model IEnumerable<StudentHub.Models.Student>

<h1>Students</h1>

@if (TempData["SuccessMessage"] != null)
{
    <p>@TempData["SuccessMessage"]</p>
}

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StudentId</td>
                <td>@s.FirstName</td>
                <td>@s.LastName</td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@s.StudentId"> 
                        Details
                    </a>
                    
                    <a asp-action="Edit"
                       asp-route-id="@s.StudentId"> 
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@s.StudentId"> 
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>